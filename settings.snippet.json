{
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/curfew/statusline.mjs"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/curfew/prompt-guard.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node ~/.claude/curfew/tool-guard.mjs" }
        ]
      }
    ]
  }
}
